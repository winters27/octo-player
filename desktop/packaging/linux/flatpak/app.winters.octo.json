{
  "app-id": "app.winters.octo",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "octo",
  "separate-locales": false,
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=x11",
    "--socket=pulseaudio",
    "--device=dri",
    "--filesystem=xdg-music",
    "--filesystem=xdg-download:ro",
    "--own-name=org.mpris.MediaPlayer2.octo",
    "--talk-name=org.freedesktop.secrets",
    "--talk-name=org.freedesktop.Notifications",
    "--system-talk-name=org.freedesktop.login1"
  ],
  "modules": [
    {
      "name": "octo",
      "buildsystem": "simple",
      "build-options": { "strip": false, "no-debuginfo": true },
      "build-commands": [
        "cp -a Octo /app/octo",
        "install -Dm755 octo /app/bin/octo",
        "install -Dm644 asound.conf /app/share/octo/asound.conf",
        "install -Dm644 octo.desktop /app/share/applications/app.winters.octo.desktop",
        "install -Dm644 octo.png /app/share/icons/hicolor/512x512/apps/app.winters.octo.png",
        "install -Dm644 app.winters.octo.metainfo.xml /app/share/metainfo/app.winters.octo.metainfo.xml"
      ],
      "sources": [{ "type": "dir", "path": "payload" }]
    }
  ]
}
