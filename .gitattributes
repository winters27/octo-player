* text=auto
gradlew text eol=lf
*.sh text eol=lf
*.patch text eol=lf
*.bat text eol=crlf
*.jar binary
*.png binary
*.ttf binary

# Signed test fixtures: their bytes are what was signed.
shared/core/src/commonTest/resources/update/** -text

# Certificates made with openssl: every checkout writes them with LF, as they were made.
fixtures/certificate-pins/*.pem text eol=lf
