  "headerList": [
    {"name": "rows from a fill keep their saved mark", "steps": [
      {"op": "replaced", "rows": [{"name": "X-Token", "value": "", "saved": true}, {"name": "Authorization", "value": "", "saved": true}], "expect": [{"name": "X-Token", "value": "", "saved": true}, {"name": "Authorization", "value": "", "saved": true}]}
    ]},
    {"name": "renaming a saved row to another name clears its mark for good", "steps": [
      {"op": "replaced", "rows": [{"name": "X-Token", "value": "", "saved": true}], "expect": [{"name": "X-Token", "value": "", "saved": true}]},
      {"op": "renamed", "row": 0, "to": "X-Other", "expect": [{"name": "X-Other", "value": "", "saved": false}]},
      {"op": "renamed", "row": 0, "to": "X-Token", "expect": [{"name": "X-Token", "value": "", "saved": false}]}
    ]},
    {"name": "the same name in another case and with spaces keeps it", "steps": [
      {"op": "replaced", "rows": [{"name": "X-Token", "value": "", "saved": true}], "expect": [{"name": "X-Token", "value": "", "saved": true}]},
      {"op": "renamed", "row": 0, "to": " x-TOKEN ", "expect": [{"name": " x-TOKEN ", "value": "", "saved": true}]}
    ]},
    {"name": "a value typed into a saved row keeps it", "steps": [
      {"op": "replaced", "rows": [{"name": "X-Token", "value": "", "saved": true}], "expect": [{"name": "X-Token", "value": "", "saved": true}]},
      {"op": "valued", "row": 0, "to": "abc", "expect": [{"name": "X-Token", "value": "abc", "saved": true}]}
    ]},
    {"name": "added makes a blank row at the end that is not saved", "steps": [
      {"op": "replaced", "rows": [{"name": "X-Token", "value": "", "saved": true}], "expect": [{"name": "X-Token", "value": "", "saved": true}]},
      {"op": "added", "expect": [{"name": "X-Token", "value": "", "saved": true}, {"name": "", "value": "", "saved": false}]},
      {"op": "renamed", "row": 1, "to": "X-New", "expect": [{"name": "X-Token", "value": "", "saved": true}, {"name": "X-New", "value": "", "saved": false}]},
      {"op": "valued", "row": 1, "to": "v", "expect": [{"name": "X-Token", "value": "", "saved": true}, {"name": "X-New", "value": "v", "saved": false}]}
    ]},
    {"name": "remove takes out only that row", "steps": [
      {"op": "replaced", "rows": [{"name": "A", "value": "1", "saved": false}, {"name": "B", "value": "2", "saved": false}, {"name": "C", "value": "3", "saved": false}], "expect": [{"name": "A", "value": "1", "saved": false}, {"name": "B", "value": "2", "saved": false}, {"name": "C", "value": "3", "saved": false}]},
      {"op": "remove", "row": 1, "expect": [{"name": "A", "value": "1", "saved": false}, {"name": "C", "value": "3", "saved": false}]}
    ]},
    {"name": "an edit for a row already removed changes nothing", "steps": [
      {"op": "replaced", "rows": [{"name": "A", "value": "1", "saved": false}, {"name": "B", "value": "2", "saved": true}], "expect": [{"name": "A", "value": "1", "saved": false}, {"name": "B", "value": "2", "saved": true}]},
      {"op": "remove", "row": 1, "expect": [{"name": "A", "value": "1", "saved": false}]},
      {"op": "renamed", "removedIn": 2, "to": "Z", "expect": [{"name": "A", "value": "1", "saved": false}]},
      {"op": "valued", "removedIn": 2, "to": "v", "expect": [{"name": "A", "value": "1", "saved": false}]},
      {"op": "remove", "removedIn": 2, "expect": [{"name": "A", "value": "1", "saved": false}]}
    ]},
    {"name": "replaced with nothing leaves no rows", "steps": [
      {"op": "replaced", "rows": [{"name": "A", "value": "1", "saved": false}], "expect": [{"name": "A", "value": "1", "saved": false}]},
      {"op": "added", "expect": [{"name": "A", "value": "1", "saved": false}, {"name": "", "value": "", "saved": false}]},
      {"op": "replaced", "rows": [], "expect": []}
    ]}
  ],
