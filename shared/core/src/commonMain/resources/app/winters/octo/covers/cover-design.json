{
  "version": 1,
  "about": "Octo's designed playlist covers, read by the phone, the desktop and the server so all three draw the same thing. Positions and sizes are shares of the cover's side (0 to 1, origin top left, y down) unless named Px. Colours are sRGB hex. Words are always white.",
  "fonts": {
    "family": "Inter 4.1 (rsms/inter v4.1, OFL-1.1), static Display cut",
    "title": "InterDisplay-SemiBold.ttf",
    "line": "InterDisplay-Light.ttf",
    "footer": "InterDisplay-Regular.ttf"
  },
  "layout": {
    "margin": 0.08,
    "contrast": 4.5,
    "tinyBelowPx": 72,
    "tinyMargin": 0.1,
    "tinySize": 0.56,
    "title": {
      "top": 0.1,
      "weight": 600,
      "size": 0.16,
      "oneLineDownTo": 0.09,
      "oneLineMinPx": 12,
      "wrapSize": 0.115,
      "wrapMinPx": 13,
      "minSize": 0.07,
      "minPx": 9,
      "maxLines": 3,
      "lineHeight": 1.08,
      "tracking": 0
    },
    "line": {
      "weight": 300,
      "shareOfTitle": 0.83,
      "minPx": 9,
      "lineHeight": 1.15,
      "tracking": 0,
      "showFromPx": 120
    },
    "footer": {
      "weight": 400,
      "size": 0.053,
      "minPx": 9,
      "bottom": 0.08,
      "opacity": 0.6,
      "lineHeight": 1.2,
      "tracking": 0,
      "showFromPx": 160
    }
  },
  "music": {
    "about": "With covers, each gradient keeps its own lightness, chroma and the spread of its hues, turned round the colour wheel so its fold colour (the colour of its first fold) takes the music's first hue. Chroma is the mean of the gradient's and the music's, at most maxChroma, and at least minChroma so a dull cover still gives a rich field.",
    "maxChroma": 0.2,
    "minChroma": 0.1
  },
