<?xml version="1.0" encoding="utf-8"?>
<!-- Quick play at 2x2: four squares that each start music. Also the
     widget's preview in the picker. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_quick_liked"
            style="@style/WidgetTile"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            android:drawableTop="@drawable/sym_favorite_filled"
            android:text="@string/widget_quick_liked" />

        <TextView
            android:id="@+id/widget_quick_recent"
            style="@style/WidgetTile"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="4dp"
            android:drawableTop="@drawable/sym_album"
            android:text="@string/widget_quick_recent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_quick_mix"
            style="@style/WidgetTile"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:drawableTop="@drawable/sym_shuffle"
            android:text="@string/widget_quick_mix" />

        <TextView
            android:id="@+id/widget_quick_resume"
            style="@style/WidgetTile"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:drawableTop="@drawable/sym_queue_music"
            android:text="@string/widget_quick_resume" />
    </LinearLayout>
</LinearLayout>
