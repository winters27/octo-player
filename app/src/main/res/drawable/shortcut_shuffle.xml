<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher shortcut, Shuffle all: a white glyph on Octo's dark glass,
     sized to sit inside the launcher's mask like its own shortcuts. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/shortcut_background" />
    <foreground>
        <inset
            android:drawable="@drawable/sym_shuffle"
            android:inset="31%" />
    </foreground>
</adaptive-icon>
