<?xml version="1.0" encoding="utf-8"?>
<!-- A widget cannot blur what is behind it, so the glass is a dark tint. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_glass" />
    <stroke android:width="1dp" android:color="@color/widget_edge" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
