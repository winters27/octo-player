<resources>
    <!-- The launch screen for each theme, picked at run time: the theme's page
         behind the logo's octopus. The Match styles name a light and a dark
         theme; their page color changes with the night mode. -->
    <style name="Theme.Octo.Splash.Octo" parent="Theme.Octo">
        <item name="android:windowBackground">#FF0C0C0D</item>
        <item name="android:windowSplashScreenBackground">#FF0C0C0D</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_octopus</item>
    </style>
    <style name="Theme.Octo.Splash.Moss" parent="Theme.Octo">
        <item name="android:windowBackground">#FF0E1512</item>
        <item name="android:windowSplashScreenBackground">#FF0E1512</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_octopus</item>
    </style>
    <style name="Theme.Octo.Splash.Dusk" parent="Theme.Octo">
